# ---------------------------------------------------------------------------
# Project Neorhiza — environment variables
# Copy to .env.local for local development. Never commit real values.
# Every variable is optional for `npm run dev` / `npm run build`; missing
# values degrade gracefully as described below.
# ---------------------------------------------------------------------------

# Public base URL of the site, without a trailing slash. Drives canonical
# URLs, sitemap.xml, robots.txt, Open Graph URLs and structured data.
# Default when unset: https://www.neorhiza.space
NEXT_PUBLIC_SITE_URL=

# Public contact address shown on the site and in structured data.
# Default when unset: inquiries@neorhiza.space
# This value is PUBLIC (bundled into the browser) — never put a secret here.
# Example: NEXT_PUBLIC_CONTACT_EMAIL=inquiries@example.org
NEXT_PUBLIC_CONTACT_EMAIL=

# ----------------------------- Contact form --------------------------------
# At least ONE delivery destination must be configured in production.
# With none configured, the form validates input and then tells the user it
# is temporarily unavailable (HTTP 503). It never pretends to succeed.

# Option A — webhook (e.g. a Zapier/Make/n8n hook or your own endpoint).
# Receives JSON: { type: "neorhiza-inquiry", receivedAt, data: {...} }
CONTACT_WEBHOOK_URL=
# Optional bearer token sent as "Authorization: Bearer <token>".
CONTACT_WEBHOOK_TOKEN=

# Option B — email via Resend (https://resend.com). All three are required.
# Sends an internal notification to CONTACT_TO_EMAIL (reply-to = visitor),
# then a confirmation of receipt to the visitor (reply-to = the first
# CONTACT_TO_EMAIL address). The confirmation contains no visitor text.
# Server-side secret: never prefix with NEXT_PUBLIC_ or commit a real key.
# Example: RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=
# Inbox that receives inquiries (comma-separate several addresses).
# Example: CONTACT_TO_EMAIL=inquiries@example.org
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend.
# Example: CONTACT_FROM_EMAIL=Project Neorhiza <website@mail.example.org>
CONTACT_FROM_EMAIL=

# ----------------------------- Rate limiting --------------------------------
# REQUIRED IN PRODUCTION: a shared store (Upstash Redis REST) so the limit
# holds across Vercel serverless instances. Both are server-side secrets.
# Adding Upstash through Vercel → Storage → Marketplace injects
# KV_REST_API_URL / KV_REST_API_TOKEN instead, or
# NEORHIZA_KV_REST_API_URL / NEORHIZA_KV_REST_API_TOKEN when the store is
# connected with the custom prefix NEORHIZA. All three naming schemes work;
# only a complete URL + token pair counts (Upstash, then KV, then NEORHIZA_KV).
# Without a store, an in-memory limiter is used: fine for local development,
# tests and previews, but per-instance (degraded) in production — the server
# logs a warning and `npm run check:config` fails.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# NEORHIZA_KV_REST_API_URL=
# NEORHIZA_KV_REST_API_TOKEN=

# Submissions allowed per client IP per window (defaults: 5 per 600 s).
CONTACT_RATE_LIMIT_MAX=
CONTACT_RATE_LIMIT_WINDOW_SECONDS=

# ------------------------- Online contributions ----------------------------
# One-time contributions via Stripe-hosted Checkout. Optional: without
# STRIPE_SECRET_KEY the Funding page shows "Secure donations are being
# prepared", the donate button is disabled and the rest of the site works.
# Both Stripe values are server-side secrets: never prefix them with
# NEXT_PUBLIC_, never commit real values. No publishable key is needed.
# Success/cancel URLs are built from NEXT_PUBLIC_SITE_URL (set it to
# http://localhost:3000 when testing checkout locally).

# Secret API key (Dashboard → Developers → API keys). Use sk_test_… for
# local/preview testing and sk_live_… (or a restricted rk_live_… key with
# Checkout Sessions write access) in production.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint /api/stripe/webhook (whsec_…).
# Locally, `stripe listen` prints a temporary one.
STRIPE_WEBHOOK_SECRET=
# Three-letter currency code: usd, eur, gbp, cad, aud, chf or kes.
DONATION_CURRENCY=usd
# Whole currency units. Invalid or inconsistent values fall back to 5 / 50000.
DONATION_MIN_AMOUNT=5
DONATION_MAX_AMOUNT=50000

# --------------------------- Search verification ----------------------------
# Optional ownership tokens for the meta-tag verification method. They are
# public by design (they appear in page source) — never put a secret here.
# Leave empty when verifying by DNS instead (recommended, see
# docs/production-launch-checklist.md).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
